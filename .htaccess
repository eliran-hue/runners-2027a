DirectoryIndex index.html index.php

# הכתובות הישנות (לפני החלוקה לקורסים) עברו לקורס הענפי.
Redirect 301 /anatomy.html /branch/anatomy/
Redirect 301 /physiology.html /branch/physiology/

# האתר לא מיועד למנועי חיפוש: מבקשים מכולם לא לאנדקס שום קובץ.
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex"
</IfModule>

# עמודי HTML: תמיד לבדוק מול השרת, כדי שעדכונים יגיעו מיד גם לגולשים לא מחוברים
# (בלי זה Varnish/Cloudflare עלולים להגיש להם עותק ישן; למחוברים יש עוגייה ולכן הם עוקפים את המטמון).
# קבצי CSS/JS נטענים עם ?v=... ולכן אפשר לשמור אותם במטמון כרגיל.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#(^|/)$|\.html?$#">
    Header always set Cache-Control "private, no-cache, max-age=0, must-revalidate"
    Header always unset Expires
  </If>
</IfModule>
