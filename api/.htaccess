# Only the PHP endpoints are reachable; schema and examples stay private.
<FilesMatch "\.(sql|md)$|^config|^_">
  Require all denied
</FilesMatch>

# Responses depend on the session cookie: never cache them anywhere (Varnish, Cloudflare, browser).
<IfModule mod_headers.c>
  Header always set Cache-Control "private, no-store, no-cache, max-age=0"
  Header always merge Vary "Cookie"
</IfModule>
